# FlexyParse environment template
# Copy to .env and review MAIN SETTINGS first. Other sections are optional tuning.
# Docker Compose and start.bat load .env; direct dotnet startup does not.
# Standard FlexyParse__... environment keys take priority over FLEXYPARSE_* aliases.

# =============================================================================
# 1. MAIN SETTINGS — review before starting
# =============================================================================

# Host port. The application listens on port 8080 inside the container.
FLEXYPARSE_PORT=8080

# Incoming HTTP API key. Empty disables authentication; set a strong key for deployment.
# This is NOT the recognition provider's API key.
FLEXYPARSE_API_KEY=

# Recognition provider: OpenAi | RapidOcr | NemotronCPU | NemotronGPU.
# OpenAi: external vision API; configure its key and model below.
# RapidOcr: local CPU OCR. NemotronCPU: local INT8. NemotronGPU: local WebGPU FP16.
FLEXYPARSE_RECOGNITION_PROVIDER=OpenAi

# CLI/library recognition default. HTTP defaults to enabled independently:
# disable recognition in the UI or send do_ocr=false to avoid recognition calls.
FLEXYPARSE_RECOGNIZE_IMAGES=true

# OpenAi only: provider API key, endpoint and vision-capable model.
# RapidOcr and Nemotron do not use these settings or require an API key.
FLEXYPARSE_MODEL_API_KEY=
FLEXYPARSE_MODEL_API_BASE_URL=https://openrouter.ai/api/v1/
FLEXYPARSE_MODEL_API_MODEL=google/gemini-3.1-flash-image

# Office/HTML conversion. Empty disables these additional formats.
# Compose: http://gotenberg:3000. Local Host/start.bat: http://localhost:3000.
FLEXYPARSE_GOTENBERG_URL=http://gotenberg:3000

# =============================================================================
# 2. LOCAL RECOGNITION — RapidOCR and Nemotron
# =============================================================================

# --- RapidOCR language ---
# Default model prefix; overridden by request ocr_language / CLI --ocr-language.
# Supported: arabic, ch, ch_server, cyrillic, devanagari, el, en, eslav,
#            korean, latin, ta, te, th.
# eslav: Russian/Ukrainian/Belarusian/English; latin: Western European languages;
# en: dedicated English model; ch/ch_server: Chinese mobile/server model.
# Use model prefixes, not language aliases (ru/uk/be) or regional tags.
# Full model coverage: src/FlexyParse.Recognition.RapidOcr/RapidOcrModelPresets.cs.
FLEXYPARSE_RAPIDOCR_LANGUAGE=eslav

# --- Nemotron execution ---
# CPU INT8 downloads ~761 MB; WebGPU FP16 downloads ~1.45 GB.
# Packs are verified and cached automatically. Allow several GB of RAM/VRAM.
# Execution mode follows the provider; no separate ExecutionMode is needed.
# No Python, CUDA/cuDNN or external recognition fallback is used.

# ONNX intra-op CPU threads (1-256), including CPU operations in GPU mode.
# This does not control GPU thread count.
FLEXYPARSE_NEMOTRON_INFERENCE_THREADS=4

# Zero-based index in the WebGPU plugin's device list, NOT a CUDA index.
# Requires a compatible GPU/driver. Ignored by CPU mode and other providers.
FLEXYPARSE_NEMOTRON_GPU_DEVICE_ID=0

# --- Linux Intel/AMD GPU Compose ---
# Start: docker compose --env-file .env -f docker/docker-compose.image.gpu.yml up --build -d
# Includes Gotenberg and fixes the provider to NemotronGPU.
# Set the numeric group ID of your GPU's render node before starting:
# stat -c '%g' /dev/dri/renderD128
# FLEXYPARSE_GPU_RENDER_GID=109

# Published image: standard uses <tag>, GPU uses <tag>-gpu.
# Only used by docker/docker-compose.yml and docker/docker-compose.gpu.yml, not local build stacks.
FLEXYPARSE_IMAGE=ghcr.io/ambyte/flexyparse
#  For GPU: FLEXYPARSE_IMAGE=ghcr.io/ambyte/flexyparse-gpu
FLEXYPARSE_IMAGE_TAG=latest

# --- Advanced Nemotron overrides (uncomment only when needed) ---
# Empty ModelsDirectory selects the mode-specific INT8/FP16 cache automatically.
# DownloadModels=false requires an already verified local cache.
# FlexyParse__Recognition__Nemotron__ModelsDirectory=
# FlexyParse__Recognition__Nemotron__DownloadModels=true
# FlexyParse__Recognition__Nemotron__InferenceThreads=4
# FlexyParse__Recognition__Nemotron__MaxHeight=2048
# FlexyParse__Recognition__Nemotron__MaxWidth=1664

# =============================================================================
# 3. LOCAL LAYOUT ANALYSIS — optional
# =============================================================================

# Native PDF table classification and image segmentation before recognition.
# Downloads the verified ~61.5 MB DocLayNet YOLO model on enabled startup.
# Native PDF analysis works even when image recognition is disabled.
# Thresholds and resource limits use the presets in Host appsettings.json.
FLEXYPARSE_IMAGE_LAYOUT_ENABLED=true

# Skip tiny images/crops before recognition for every provider; retain originals for export.
# All three inclusive thresholds must be met, independent of image orientation.
# FlexyParse__ImageRecognitionFilter__Enabled=true
# FlexyParse__ImageRecognitionFilter__MinShortSide=24
# FlexyParse__ImageRecognitionFilter__MinLongSide=80
# FlexyParse__ImageRecognitionFilter__MinPixels=4096

# =============================================================================
# 4. OPENAI-COMPATIBLE API — advanced, OpenAi provider only
# =============================================================================

# Set false for a local API server that does not require authentication.
FLEXYPARSE_MODEL_API_REQUIRE_API_KEY=true

# Per-image response timeout in seconds and attempts for temporary API errors.
FLEXYPARSE_MODEL_API_TIMEOUT_SECONDS=180
FLEXYPARSE_MODEL_API_MAX_ATTEMPTS=3

# Maximum response tokens and the parameter name expected by the API.
# Token parameter: max_completion_tokens or max_tokens.
FLEXYPARSE_MODEL_API_MAX_COMPLETION_TOKENS=16384
FLEXYPARSE_MODEL_API_TOKEN_LIMIT_PARAMETER=max_completion_tokens

# Generation temperature. Empty omits the parameter.
FLEXYPARSE_MODEL_API_TEMPERATURE=0

# Maximum image payload in bytes: 4194304 = 4 MiB.
FLEXYPARSE_MODEL_API_MAX_IMAGE_BYTES=4194304

# Optional OpenRouter headers; sent only to https://openrouter.ai/api/v1[/].
# X-Title and HTTP-Referer respectively. The referrer can be empty.
FLEXYPARSE_MODEL_API_TITLE=FlexyParse
FLEXYPARSE_MODEL_API_HTTP_REFERER=

# =============================================================================
# 5. PROCESSING LIMITS AND GOTENBERG
# =============================================================================

# Concurrent document conversions. 0 selects concurrency from processor count.
FLEXYPARSE_MAX_CONCURRENT_DOCUMENTS=2

# Concurrent OpenAi image calls. Local providers have separate concurrency gates.
FLEXYPARSE_MAX_CONCURRENT_IMAGE_RECOGNITIONS=4

# Per-document size limit, including PDF output from Gotenberg. 2147483648 = 2 GiB.
FLEXYPARSE_MAX_UPLOAD_BYTES=2147483648

# Maximum files in a batch request.
FLEXYPARSE_MAX_FILES_PER_REQUEST=16

# Gotenberg conversion timeout in seconds; also configures the bundled service.
FLEXYPARSE_GOTENBERG_TIMEOUT_SECONDS=180

# =============================================================================
# 6. BACKGROUND JOBS — queue, retention and status observers
# =============================================================================
# All values must be positive. Tasks/results are process-local and lost on restart.

# Concurrent workers; shared document-processing limits still apply.
FLEXYPARSE_ASYNC_WORKER_COUNT=2

# Pending-task limit, including admission/staging; running tasks are not counted.
FLEXYPARSE_ASYNC_QUEUE_CAPACITY=32

# Total registered tasks: pending, running and retained completions/failures.
FLEXYPARSE_ASYNC_MAX_STORED_TASKS=128

# Completed status/result retention and cleanup interval, in seconds.
FLEXYPARSE_ASYNC_RESULT_RETENTION_SECONDS=3600
FLEXYPARSE_ASYNC_CLEANUP_INTERVAL_SECONDS=60

# Maximum simultaneous WebSocket status observers per Host.
FLEXYPARSE_ASYNC_MAX_WEBSOCKET_CONNECTIONS=64

# =============================================================================
# 7. DEBUGGING — normally leave disabled
# =============================================================================

# Preserve results and workspaces in the system temporary directory.
# Retained files can contain sensitive documents; restrict access and clean manually.
FLEXYPARSE_KEEP_RESULTS=false
